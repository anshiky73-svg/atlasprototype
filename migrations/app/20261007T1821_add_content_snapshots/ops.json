    "execute": [
      {
        "description": "create table \"ContentSnapshot\"",
        "sql": "CREATE TABLE \"public\".\"ContentSnapshot\" (\n  \"contentHash\" text,\n  \"crawlRunId\" int4 NOT NULL,\n  \"discoveredUrlId\" int4 NOT NULL,\n  \"errorMessage\" text,\n  \"extractedText\" text,\n  \"finalUrl\" text NOT NULL,\n  \"httpStatus\" int4,\n  \"id\" SERIAL NOT NULL,\n  \"requestedUrl\" text NOT NULL,\n  \"retrievedAt\" timestamptz DEFAULT (now()) NOT NULL,\n  PRIMARY KEY (\"id\")\n)",
        "params": []
      }
    ],
